# SAM.gov API key — get one at https://api.sam.gov/
SAM_GOV_API_KEY=your_sam_gov_api_key

# Anthropic API key for Claude scoring
ANTHROPIC_API_KEY=your_anthropic_api_key

# Notion integration token + database ID
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: override scoring model
# SCORING_MODEL_STAGE1=claude-haiku-4-5-20251001
# SCORING_MODEL_STAGE2=claude-sonnet-4-6

# Enabled sources (comma-separated). Available: sam_gov, nevada_epro
ENABLED_SOURCES=sam_gov
