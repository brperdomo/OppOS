# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
SAM_GOV_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
NOTION_TOKEN=
NOTION_DATABASE_ID=
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_DIGEST_CHANNEL=
# OPPOS_APP_URL=https://nutrient-opp-os.streamlit.app   # dashboard URL for the "Open on my desk" button in Slack messages
# PORTAL_ACCESS_REQUEST_URL=   # service-desk form for requesting a vendor-portal account (defaults to Nutrient's IT portal request form)
NUTRIENT_API_KEY=
# Optional: ground Stage 2 capability claims against Nutrient docs via Kapa's hosted MCP server
KAPA_MCP_URL=
KAPA_API_KEY=
# Response drafting (Stage 3). Default model claude-opus-5; one call per pursued RFP.
# DRAFT_MODEL=claude-opus-5
# DRAFT_MAX_TOKENS=16000
# Requirement extraction from RFP PDFs via Nutrient Data Extraction API (uses NUTRIENT_API_KEY)
# EXTRACTION_MODE=understand   # text | structure | understand | agentic
# EXTRACTION_MAX_PAGES=80
# Nutrient Document Authoring SDK license (in-app response editor + DOCX/PDF export); evaluation watermark without it
# DOCAUTH_LICENSE_KEY=
# VIEWER_LICENSE_KEY=   # Nutrient Web SDK key for the in-page PDF preview (trial watermark without it)
ENABLED_SOURCES=sam_gov
# Optional
# OPPOS_ADMINS=you@nutrient.io
# OPPOS_MEMBERS=a@nutrient.io,b@nutrient.io   # who can grab and work RFPs (admins can also manage the list in the app); empty = open access
# OPPOS_DEV_USER=Your Name <you@nutrient.io>
# LOB_OWNER_WORKFLOW=
# LINK_PROBE_MAX_PER_SOURCE=1000   # new listings whose links are checked per source per scan (the rest wait for the next scan)
