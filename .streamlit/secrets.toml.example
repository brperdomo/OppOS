# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → Settings → Secrets.
# Leave the [auth] block out entirely to run without sign-in (single local user).

[auth]
# Local:  http://localhost:8501/oauth2callback
# Cloud:  https://nutrient-opp-os.streamlit.app/oauth2callback  (add both to the Google OAuth client)
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
